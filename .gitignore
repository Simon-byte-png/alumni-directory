data/runtime/
data/alumni.json
data/account-seed.json
data/question-seed.json
data/pending-account-review.json
data/auth-state.json
data/auth-state.json.bak
data/session.key

# 名单原始导出和人工核对中间文件不进 Git
data/roster-*.json
data/roster-*.csv

# 原始上传的 Excel（含联系方式等隐私原件）
*.xlsx

# 系统/编辑器杂项
.DS_Store
*.log
npm-debug.log*
